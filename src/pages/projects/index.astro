---
import ConstructionZone from '../../components/ConstructionZone.astro';
import ProjectList from '../../components/ProjectList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects"
  description="A list of side projects I've worked on."
>
  <header class="page-header">
    <h1>Projects</h1>
    <ConstructionZone />
    <p>
      A random assortment of things I've tinkered with. More on <a
        href="https://github.com/simonxiang1"
        target="_blank"
        rel="noreferrer">Github</a
      >.
    </p>
  </header>
  <section class="project-page-list" aria-label="All projects">
    <ProjectList />
  </section>
</BaseLayout>
