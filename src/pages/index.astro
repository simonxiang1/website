---
import { getCollection } from 'astro:content';
import Extras from '../components/Extras.astro';
import BlogPostList from '../components/BlogPostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { sortBlogPosts } from '../data/blogPosts';
import BaseLayout from '../layouts/BaseLayout.astro';

const blogPosts = sortBlogPosts(
  await getCollection('blog_posts', ({ data }) => !data.draft),
);
---

<BaseLayout>
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <h1 id="intro-title">Simon Xiang</h1>
      <p class="intro-subtitle">SWE @ AWS · Seattle</p>
      <p class="lede">
        Hi, I'm Simon. Welcome to my personal website! Currently, I work as a
        software engineer at AWS - formerly I was a quantitative researcher at a
        QuantLab spinoff. I graduated in Fall 2023 with a degree in pure math
        from UT Austin.
      </p>
      <p class="lede">
        I'm interested in systems, machine learning, LLMs, mathematics, and the
        overlap between them. If you want to chat, feel free to reach out!
      </p>
    </div>
  </section>

  <hr class="intro-rule" />

  <section class="home-section" aria-labelledby="projects-title">
    <div class="section-heading-row">
      <h2 id="projects-title">Projects</h2>
      <a class="quiet-link" href="/projects/">all projects</a>
    </div>
    <ProjectList limit={3} />
  </section>

  <section class="home-section" aria-labelledby="blog-title">
    <div class="section-heading-row">
      <div>
        <h2 id="blog-title">Recent writing</h2>
      </div>
      <a class="quiet-link" href="/blog/">all posts</a>
    </div>
    <BlogPostList posts={blogPosts} limit={3} detailed />
  </section>

  <Extras />
</BaseLayout>
