---
const path = Astro.url.pathname;

const links = [
  { href: '/about/', label: 'about' },
  { href: '/blog/', label: 'blog' },
  { href: '/projects/', label: 'projects' },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Simon Xiang, home">
    <img src="/icons/site-mark-64.png" alt="" width="64" height="64" />
    <span>Simon Xiang</span>
  </a>
  <nav aria-label="Primary navigation">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={path.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      role="switch"
      aria-checked="false"
      aria-label="Use dark theme"
      title="Change color theme"
    >
      <span class="theme-track" aria-hidden="true">
        <span class="theme-thumb"></span>
      </span>
    </button>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');

  function currentTheme() {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function updateLabel() {
    if (button) {
      button.ariaChecked = String(currentTheme() === 'dark');
      button.ariaLabel =
        currentTheme() === 'dark' ? 'Use light theme' : 'Use dark theme';
    }
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute(
        'content',
        currentTheme() === 'dark' ? '#1b1c1d' : '#fffcf0',
      );
  }

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    updateLabel();
  });

  updateLabel();
</script>
